PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Set to "true" only if KindGuard is deployed behind a real reverse proxy
# / load balancer that sets X-Forwarded-For (e.g. Render, Heroku, nginx).
# Leave false/unset otherwise — trusting that header without a real proxy
# in front of you lets anyone spoof their IP and dodge the rate limiter.
TRUST_PROXY=false

# Free-tier scans allowed per IP per rolling 30 days before KindGuard asks
# the user to upgrade to Premium. Enforced in services/rateLimiter.js.
FREE_MONTHLY_SCAN_LIMIT=3

# Google Safe Browsing API key (free tier) — used for malware/blacklist checks
# Get one at https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=

# VirusTotal API key (free tier) — used as a secondary blacklist/reputation check
# Get one at https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
